{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nexus Flask",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NEXUS_ENV": "development",
        "FLASK_DEBUG": "true"
      },
      "justMyCode": true
    }
  ]
}